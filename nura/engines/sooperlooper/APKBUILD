# Contributor: Hannes Janetzek <hannes.janetzek@gmail.com>
# SooperLooper, the looper zynthian runs as its own engine (zynthian_engine_sooperlooper: the
# `sooperlooper` binary controlled over OSC; Debian's sooperlooper on ZynthianOS). Debian's source
# and patches (no dmalloc, current liblo API, missing ALSA sequencer, cross); without the wxWidgets
# GUI (slgui), as zynthian has its own widget.
pkgname=sooperlooper
pkgver=1.7.9
pkgrel=0
_debver=1.7.9+dfsg
pkgdesc="Live looping sampler (headless, controlled over OSC)"
url="https://sonosaurus.com/sooperlooper/"
arch="all"
license="GPL-2.0-or-later"
makedepends="
	alsa-lib-dev
	autoconf
	automake
	fftw-dev
	gettext-dev
	jack-dev
	libsamplerate-dev
	libsigc++-dev
	libsndfile-dev
	libtool
	liblo-dev
	libxml2-dev
	musl-fts-dev
	ncurses-dev
	rubberband-dev
	"
source="https://deb.debian.org/debian/pool/main/s/sooperlooper/sooperlooper_$_debver.orig.tar.xz
	02-remove_dmalloc.patch
	11-fix_liblo_OSC_API_compatibility.patch
	12-handle-missing-alsa-sequencer.patch
	13-cross.patch
	"
builddir="$srcdir/essej-sooperlooper-92515b2"
options="!check" # no tests

prepare() {
	default_prepare
	sh ./autogen.sh
}

build() {
	# C++11 as Debian builds it (old code, e.g. std::auto_ptr-era idioms)
	export CXXFLAGS="$CXXFLAGS -std=gnu++11"
	# fts(3) (libs/pbd/ftw.cc) is a separate library on musl
	export LIBS="-lfts"
	./configure \
		--build=$CBUILD \
		--host=$CHOST \
		--prefix=/usr \
		--without-gui
	make
}

package() {
	make DESTDIR="$pkgdir" install
}
