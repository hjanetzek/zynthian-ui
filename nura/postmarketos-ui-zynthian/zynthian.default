# Settings for the zynthian kiosk session (/etc/cage-ui/zynthian.sh), read when the session
# starts: kiosk-session switches them, or edit and run sudo systemctl restart tinydm.

# UI: qt (Qt Quick, native Wayland) or tk (Tkinter through XWayland)
ZYNTHIAN_UI=qt

# Output scale for the Qt UI (wlr-randr --scale, default 1.5; 2 for a larger UI; empty: leave
# cage's scale 1). The Tk UI always runs at scale 1.
#ZYNTHIAN_OUTPUT_SCALE=1.5
