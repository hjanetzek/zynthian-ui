	distrho-ports-lv2
	dpf-plugins-lv2
	dragonfly-reverb-lv2
	eq10q-lv2
	guitarix-lv2
	gxplugins-lv2
	infamous-lv2
	invada-lv2
	mda-lv2
	mimid-lv2
