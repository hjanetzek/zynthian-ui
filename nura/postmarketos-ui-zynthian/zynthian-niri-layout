#!/usr/bin/python3
"""Layout of the zynthian-niri session: "workspaces" or "scrolling".

  zynthian-niri-layout [toggle|workspaces|scrolling|get]

workspaces: zynthian alone on its workspace (a full-width column), every other window full-screen
            on a workspace of its own (zynthian-niri-workspaces); niri's overview to switch.
scrolling:  all windows as columns side by side on zynthian's workspace (niri's scrolling layout),
            moved through with focus-column-left/right (keys) or the overview.

The mode is kept in $XDG_RUNTIME_DIR/zynthian-niri-layout; zynthian-niri-workspaces places new
windows by it.
"""
import json
import os
import subprocess
import sys

MODE_FILE = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "zynthian-niri-layout")
ZYNTHIAN_APP_ID = "zynthian"


def is_zynthian(w):
    # by app_id, or by title (a UI without setDesktopFileName has app_id python3)
    return w.get("app_id") == ZYNTHIAN_APP_ID or (w.get("app_id") == "python3"
                                                   and w.get("title") == "zynthian")


def niri(*args):
    return subprocess.run(["niri", "msg", *args], capture_output=True, text=True)


FULLSCREEN_FILE = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "zynthian-niri-fullscreen")


def fullscreen_ids():
    # The windows made full-screen here (niri can only toggle full-screen, and doesn't report it)
    try:
        with open(FULLSCREEN_FILE) as f:
            return set(json.load(f))
    except (OSError, ValueError):
        return set()


def save_fullscreen_ids(ids):
    with open(FULLSCREEN_FILE, "w") as f:
        json.dump(sorted(ids), f)


def set_fullscreen(wid, on):
    ids = fullscreen_ids()
    if on != (wid in ids):
        niri("action", "fullscreen-window", "--id", str(wid))
        ids = ids | {wid} if on else ids - {wid}
        save_fullscreen_ids(ids)


def get_mode():
    try:
        with open(MODE_FILE) as f:
            mode = f.read().strip()
    except OSError:
        mode = ""
    return mode if mode in ("workspaces", "scrolling") else "workspaces"


def set_mode(mode):
    with open(MODE_FILE, "w") as f:
        f.write(mode + "\n")
    windows = json.loads(niri("--json", "windows").stdout or "[]")
    others = [w for w in windows if not is_zynthian(w)]
    zyn = [w for w in windows if is_zynthian(w)]
    for w in others:
        wid = str(w["id"])
        if mode == "scrolling":
            set_fullscreen(w["id"], False)
            niri("action", "move-window-to-workspace", "--window-id", wid, "--focus", "false",
                 "zynthian")
            niri("action", "move-window-to-tiling", "--id", wid)
        else:
            niri("action", "move-window-to-floating", "--id", wid)
            # the last workspace is always empty: each window gets a new one
            niri("action", "move-window-to-workspace", "--window-id", wid, "--focus", "false",
                 "255")
            set_fullscreen(w["id"], True)
    niri("action", "focus-workspace", "zynthian")
    if zyn:
        niri("action", "focus-window", "--id", str(zyn[0]["id"]))


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else "toggle"
    if cmd == "get":
        print(get_mode())
    elif cmd == "toggle":
        set_mode("scrolling" if get_mode() == "workspaces" else "workspaces")
    elif cmd in ("workspaces", "scrolling"):
        set_mode(cmd)
    else:
        sys.exit(__doc__)


main()
