# Contributor: Hannes Janetzek <hannes.janetzek@gmail.com>
# abl_link~: Ableton Link for Pure Data (tempo/beat sync), used by most of zynthian's Organelle
# patches. Link and its asio-standalone are git submodules, not in GitHub's archives: extra
# sources at the submodules' commits, put where the submodules go. Installed to
# /usr/lib/pd/extra/abl_link~.
pkgname=pd-abl-link
pkgver=0.6
_link=17479b417973f1ae182757a1e1c512214bc05669
_asio=01b4e87c04abd4daec58e40463bcdc150085b269
pkgrel=0
pkgdesc="Ableton Link for Pure Data (abl_link~)"
url="https://github.com/libpd/abl_link"
arch="all"
license="GPL-2.0-or-later"
depends="puredata"
makedepends="puredata-dev linux-headers"
source="$pkgname-$pkgver.tar.gz::https://github.com/libpd/abl_link/archive/v$pkgver.tar.gz
	link-$_link.tar.gz::https://github.com/Ableton/link/archive/$_link.tar.gz
	asio-$_asio.tar.gz::https://github.com/chriskohlhoff/asio/archive/$_asio.tar.gz"
builddir="$srcdir/abl_link-$pkgver"
options="!check" # no tests

prepare() {
	default_prepare
	rm -rf external/link
	mv "$srcdir"/link-$_link external/link
	rm -rf external/link/modules/asio-standalone
	mv "$srcdir"/asio-$_asio external/link/modules/asio-standalone
	# Pd 0.55+ no longer declares error(); pd still exports it
	cat > pd-legacy.h <<-'EOH'
		#include "m_pd.h"
		#ifdef __cplusplus
		extern "C" {
		#endif
		EXTERN void error(const char *fmt, ...);
		#ifdef __cplusplus
		}
		#endif
	EOH
}

build() {
	make -C external PDINCLUDEDIR=/usr/include/pd CPPFLAGS="-include $builddir/pd-legacy.h"
}

package() {
	make -C external install PDINCLUDEDIR=/usr/include/pd CPPFLAGS="-include $builddir/pd-legacy.h" DESTDIR="$pkgdir" pkglibdir=/usr/lib/pd/extra
}
