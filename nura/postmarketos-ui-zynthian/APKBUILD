# Kiosk UI for postmarketOS/Nura: boots straight into zynthian (cage, XWayland, PipeWire).
pkgname=postmarketos-ui-zynthian
pkgver=1
pkgrel=5
pkgdesc="zynthian synthesizer platform as a kiosk (Wayland, cage)"
arch="noarch"
url="https://github.com/zynthian/zynthian-ui"
license="GPL-3.0-or-later"
options="!check pmb:drm pmb:support-systemd"
# Engines: those packaged by Alpine (jalv and sfizz are in testing). zynaddsubfx, setBfree,
# Aeolus, sooperlooper and linuxsampler are not packaged yet.
depends="
	calf
	fluidsynth
	jack_capture
	jalv
	mda-lv2
	pipewire-jack
	pipewire-tools
	postmarketos-base-ui-cage
	sfizz
	x42-plugins
	zynthian-ui
	"
backup="etc/default/zynthian"
_pmb_groups="audio seat"
source="
	zynthian.sh
	50-zynthian-realtime.conf
	zynthian-xwayland.sh
	xwayland-noglamor
	kiosk-session
	zynthian.default
	"

package() {
	install -Dm644 "$srcdir"/zynthian.sh -t "$pkgdir"/etc/cage-ui/
	install -Dm644 "$srcdir"/50-zynthian-realtime.conf \
		-t "$pkgdir"/usr/lib/systemd/system/tinydm.service.d/
	# XWayland without glamor on Panfrost (set before cage starts, see zynthian-xwayland.sh)
	install -Dm644 "$srcdir"/zynthian-xwayland.sh \
		"$pkgdir"/usr/share/tinydm/env-wayland.d/60-zynthian-xwayland.sh
	install -Dm755 "$srcdir"/xwayland-noglamor -t "$pkgdir"/usr/libexec/zynthian/
	# Switching between kiosk sessions (zynthian Qt/Tk, Zrythm, ...) and the UI setting
	install -Dm755 "$srcdir"/kiosk-session -t "$pkgdir"/usr/bin/
	install -Dm644 "$srcdir"/zynthian.default "$pkgdir"/etc/default/zynthian
}

