# Kiosk UI for postmarketOS/Nura: boots straight into zynthian (cage, XWayland, PipeWire).
pkgname=postmarketos-ui-zynthian
pkgver=1
pkgrel=21
pkgdesc="zynthian synthesizer platform as a kiosk (Wayland, cage)"
arch="noarch"
url="https://github.com/zynthian/zynthian-ui"
license="GPL-3.0-or-later"
options="!check pmb:drm pmb:support-systemd"
# Engines: those packaged by Alpine (jalv and sfizz are in testing), and ZynAddSubFX, setBfree,
# SooperLooper and LinuxSampler with gigtools (nura-builds: aports/engines/); Aeolus comes with
# zynthian-ui (its dependency). Large data (SoundFonts, packs) stays out of the image: zynthian-factory-content installs it.
# LV2 plugins: zynthian-lv2-plugins (nura-builds: aports/lv2/), the plugins zynthian enables by default as far as
# they are packaged; state and the missing ones: nura-builds' docs/lv2-plugins.md. Pure Data for the
# puredata engine: zynthian-puredata (nura-builds: aports/pd/). DrivenByMoss's controller drivers (with
# the NI Maschine Mk2/JAM support): drivenbymoss-rust's nura/ recipe. The web configuration
# (zynthian-webconf, port 8080) and the content pack catalogue it installs from (zynthian-packages):
# their nura branches' recipes.
depends="
	drivenbymoss
	fluidsynth
	gigtools
	jack_capture
	jalv
	jq
	linuxsampler
	pipewire-jack
	pipewire-tools
	postmarketos-base-ui-cage
	setbfree
	sfizz
	wlr-randr
	zynthian-lv2-plugins
	zynthian-puredata
	zynaddsubfx
	zynthian-packages
	zynthian-ui
	zynthian-webconf
	"
backup="etc/default/zynthian"
# zynthian in niri instead of cage: plugin windows (X11 through xwayland-satellite), each on its own
# workspace, with niri's overview to switch (kiosk-session zynthian-niri)
subpackages="$pkgname-niri:_niri:noarch"
_pmb_groups="audio seat"
source="
	zynthian.sh
	zynthian-session.sh
	zynthian-niri
	zynthian-niri-ui
	zynthian-niri-workspaces
	zynthian-niri-layout
	zynthian-niri.kdl
	zynthian-niri.desktop
	50-zynthian-realtime.conf
	zynthian-xwayland.sh
	xwayland-noglamor
	kiosk-session
	zynthian.default
	90-zynthian-touch-rotation.rules
	zynthian-cpu-setup
	60-zynthian-cpu.conf
	"

package() {
	install -Dm644 "$srcdir"/zynthian.sh -t "$pkgdir"/etc/cage-ui/
	# Shared by the cage and niri sessions: device defaults, audio, zynthian's environment
	install -Dm644 "$srcdir"/zynthian-session.sh -t "$pkgdir"/usr/libexec/zynthian/
	install -Dm644 "$srcdir"/50-zynthian-realtime.conf \
		-t "$pkgdir"/usr/lib/systemd/system/tinydm.service.d/
	# XWayland without glamor on Panfrost (set before cage starts, see zynthian-xwayland.sh)
	install -Dm644 "$srcdir"/zynthian-xwayland.sh \
		"$pkgdir"/usr/share/tinydm/env-wayland.d/60-zynthian-xwayland.sh
	install -Dm755 "$srcdir"/xwayland-noglamor -t "$pkgdir"/usr/libexec/zynthian/
	# Switching between kiosk sessions (zynthian Qt/Tk, Zrythm, ...) and the UI setting
	install -Dm755 "$srcdir"/kiosk-session -t "$pkgdir"/usr/bin/
	install -Dm644 "$srcdir"/zynthian.default "$pkgdir"/etc/default/zynthian
	# Touch input rotated with the output on devices whose panel has no orientation (Pixel 3)
	install -Dm644 "$srcdir"/90-zynthian-touch-rotation.rules -t "$pkgdir"/usr/lib/udev/rules.d/
	# CPU idle states and governor before each session (ZYNTHIAN_IDLE_CPUS, ZYNTHIAN_GOVERNOR)
	install -Dm755 "$srcdir"/zynthian-cpu-setup -t "$pkgdir"/usr/libexec/zynthian/
	install -Dm644 "$srcdir"/60-zynthian-cpu.conf \
		-t "$pkgdir"/usr/lib/systemd/system/tinydm.service.d/
}

_niri() {
	pkgdesc="zynthian with plugin windows, each on its own workspace (niri)"
	depends="$pkgname=$pkgver-r$pkgrel niri xwayland-satellite xwayland python3 zynthian-jalv-gtk"
	install -Dm755 "$srcdir"/zynthian-niri "$srcdir"/zynthian-niri-ui \
		"$srcdir"/zynthian-niri-workspaces "$srcdir"/zynthian-niri-layout \
		-t "$subpkgdir"/usr/libexec/zynthian/
	install -Dm644 "$srcdir"/zynthian-niri.kdl "$subpkgdir"/etc/xdg/zynthian-niri/config.kdl
	install -Dm644 "$srcdir"/zynthian-niri.desktop -t "$subpkgdir"/usr/share/wayland-sessions/
}

