# Contributor: Hannes Janetzek <hannes.janetzek@gmail.com>
# YK Chorus (URI https://chrisarndt.de/plugins/ykchorus), enabled by default in zynthian
# (zynthian-sys recipe install_ykchorus.sh). DPF is a git submodule: second source at its commit.
pkgname=ykchorus-lv2
_commit=ee0e362f8ef30b55a440715e4da3bfb3dad6a30f
_dpf=077fcf5758ed6038bfe6e7aee1e407aa02e807b2
pkgver=0_git20240527
pkgrel=0
pkgdesc="YK Chorus LV2 plugin"
url="https://github.com/SpotlightKid/ykchorus"
arch="all"
license="GPL-2.0-or-later"
# bash: DPF's utils/generate-ttl.sh (run in build()) is a bash script
makedepends="bash lv2-dev"
source="$pkgname-$_commit.tar.gz::https://github.com/SpotlightKid/ykchorus/archive/$_commit.tar.gz
	dpf-$_dpf.tar.gz::https://github.com/DISTRHO/DPF/archive/$_dpf.tar.gz"
builddir="$srcdir/ykchorus-$_commit"
options="!check" # no tests

prepare() {
	default_prepare
	rmdir dpf
	mv "$srcdir"/DPF-$_dpf dpf
}

build() {
	# The top-level 'all' builds DPF's GUI library first (needs pugl, another submodule): build
	# only the plugin's DSP part as LV2, then generate its TTL
	make -C plugins/YKChorus NOOPT=true HAVE_OPENGL=false lv2_dsp
	make -C dpf/utils/lv2-ttl-generator
	dpf/utils/generate-ttl.sh
}

package() {
	mkdir -p "$pkgdir"/usr/lib/lv2
	cp -r bin/*.lv2 "$pkgdir"/usr/lib/lv2/
}
sha512sums="
