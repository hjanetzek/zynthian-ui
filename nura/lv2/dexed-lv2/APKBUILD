# Contributor: Hannes Janetzek <hannes.janetzek@gmail.com>
# Dexed, the DX7 FM synth, as dcoredump's native LV2 port (URI https://github.com/dcoredump/dexed.lv2;
# zynthian's recipe install_dexed_lv2.sh). It is written against lvtk 1 (not packaged): its
# headers come from the lvtk 1.2.0 source, and its plugin library (one file) is linked in.
# No GUI; the modgui images left out. CPU/PLATFORM empty: the Makefile's aarch64 flags are Cortex-A53 and
# -mcmodel=tiny.
pkgname=dexed-lv2
_commit=32cce1ec397899e27e5932e3f732b3f1bf95de6e
_lvtk=1.2.0
pkgver=0_git20221116
pkgrel=0
pkgdesc="Dexed DX7 FM synthesizer LV2 plugin (dexed.lv2)"
url="https://github.com/dcoredump/dexed.lv2"
arch="all"
license="GPL-3.0-or-later"
makedepends="lv2-dev"
source="$pkgname-$_commit.tar.gz::https://github.com/dcoredump/dexed.lv2/archive/$_commit.tar.gz
	lvtk-$_lvtk.tar.gz::https://github.com/lvtk/lvtk/archive/$_lvtk.tar.gz"
builddir="$srcdir/dexed.lv2-$_commit/src"
options="!check" # no tests

build() {
	local lvtk="$srcdir"/lvtk-$_lvtk
	${CXX:-g++} $CXXFLAGS -fPIC -I"$lvtk" -c "$lvtk"/src/plugin.cpp -o lvtk_plugin.o
	make CPU= FPU= PLATFORM= \
		CXXFLAGS_LVTK="-I$lvtk" \
		LDFLAGS_LVTK="$PWD/lvtk_plugin.o"
}

package() {
	mkdir -p "$pkgdir"/usr/lib/lv2
	cp -r dexed.lv2 "$pkgdir"/usr/lib/lv2/
	rm -rf "$pkgdir"/usr/lib/lv2/dexed.lv2/modgui
}
sha512sums="
