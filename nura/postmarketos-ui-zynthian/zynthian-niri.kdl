// niri config of the zynthian-niri session (zynthian-niri prepends the output settings).
// Reference: https://github.com/YaLTeR/niri/wiki/Configuration:-Introduction

// zynthian as a full-width column on its own, always-present first workspace (without gaps,
// borders or bars that looks like full-screen, and other windows can be columns next to it in the
// scrolling layout); every other window gets a workspace of its own (zynthian-niri-workspaces).
// Plugin windows float: they keep the size the plugin asks for and are centred. Layouts: see
// zynthian-niri-layout.
workspace "zynthian"

window-rule {
    open-floating true
}
// zynthian by its app_id, or by its title (a UI without setDesktopFileName has app_id python3)
window-rule {
    match app-id="^zynthian$"
    match app-id="^python3$" title="^zynthian$"
    open-on-workspace "zynthian"
    open-floating false
    open-maximized true
}

layout {
    gaps 0
    focus-ring { off; }
    border { off; }
    background-color "#000000"
}

// The overview: all workspaces zoomed out; a tap picks one
overview {
    zoom 0.6
    backdrop-color "#101010"
}

// No animations: they cost CPU/GPU time next to the audio
animations { off; }

prefer-no-csd
hotkey-overlay { skip-at-startup; }
screenshot-path null

// Panfrost: if X11 plugin windows show black rectangles, start XWayland without glamor
// (docs/nura-display.md) in /etc/xdg/zynthian-niri/local.kdl:
//   environment { XWAYLAND_NO_GLAMOR "1"; }

// Mod is Super: on Chromebook keyboards (the Duet's) the search key, where Caps Lock usually is.
// The main actions also on Ctrl+Alt.
binds {
    Mod+O { toggle-overview; }
    Ctrl+Alt+O { toggle-overview; }
    Mod+Z { focus-workspace "zynthian"; }
    Ctrl+Alt+Z { focus-workspace "zynthian"; }
    Mod+Tab { focus-workspace-previous; }
    Mod+Page_Down { focus-workspace-down; }
    Mod+Page_Up { focus-workspace-up; }
    Mod+Q { close-window; }
    // A test window (an OpenGL X11 client, mesa-demos): it gets a workspace of its own
    Mod+T { spawn "glxgears"; }
    Ctrl+Alt+T { spawn "glxgears"; }
    // Layout: each window on its own workspace <-> all windows as columns on one (scrolling)
    Mod+S { spawn "/usr/libexec/zynthian/zynthian-niri-layout" "toggle"; }
    Ctrl+Alt+S { spawn "/usr/libexec/zynthian/zynthian-niri-layout" "toggle"; }
    // Scrolling layout: the column left/right
    Mod+Left { focus-column-left; }
    Mod+Right { focus-column-right; }
    Ctrl+Alt+Left { focus-column-left; }
    Ctrl+Alt+Right { focus-column-right; }
    Mod+Shift+E { quit; }
}

spawn-at-startup "/usr/libexec/zynthian/zynthian-niri-ui"
spawn-at-startup "/usr/libexec/zynthian/zynthian-niri-workspaces"
