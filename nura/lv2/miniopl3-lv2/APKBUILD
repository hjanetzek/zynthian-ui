# Contributor: Hannes Janetzek <hannes.janetzek@gmail.com>
# MiniOPL3 (URI http://jpcima.sdf1.org/lv2/miniopl3), an OPL3 FM synth, enabled by default in
# zynthian (zynthian-sys recipe install_miniopl3.sh). DPF and libADLMIDI are git submodules: extra
# sources at their commits. DSP only (no GUI); the LV2 presets are generated from the bundled banks.
pkgname=miniopl3-lv2
_commit=205ae767f7e2e9d839df2718746ea1d3e3f492b8
_dpf=4e180a77ec6e93abb021b28495bd84b43498bf31
_adlmidi=75f2f1b7677e1bc44fa1ff9cb11ff0b0616f5afa
pkgver=0_git20200111
pkgrel=0
pkgdesc="MiniOPL3 FM synthesizer LV2 plugin"
url="https://github.com/jpcima/miniopl3"
arch="all"
license="ISC AND LGPL-2.1-or-later"
# bash: DPF's utils/generate-ttl.sh is a bash script
makedepends="bash lv2-dev"
source="$pkgname-$_commit.tar.gz::https://github.com/jpcima/miniopl3/archive/$_commit.tar.gz
	dpf-$_dpf.tar.gz::https://github.com/DISTRHO/DPF/archive/$_dpf.tar.gz
	libadlmidi-$_adlmidi.tar.gz::https://github.com/Wohlstand/libADLMIDI/archive/$_adlmidi.tar.gz"
builddir="$srcdir/miniopl3-$_commit"
options="!check" # no tests

prepare() {
	default_prepare
	rmdir dpf thirdparty/libADLMIDI
	mv "$srcdir"/DPF-$_dpf dpf
	mv "$srcdir"/libADLMIDI-$_adlmidi thirdparty/libADLMIDI
}

build() {
	make -C plugins/MiniOPL3 NOOPT=true HAVE_DGL=false HAVE_OPENGL=false lv2_dsp
	make -C plugins/MiniOPL3 HOSTCXX="${CXX:-g++}" presets
	make -C dpf/utils/lv2-ttl-generator
	# the old DPF script finds its generator relative to $0, after a cd: call it by absolute path
	"$builddir"/dpf/utils/generate-ttl.sh
}

package() {
	mkdir -p "$pkgdir"/usr/lib/lv2
	cp -r bin/*.lv2 plugins/MiniOPL3/presets/miniopl3-presets.lv2 "$pkgdir"/usr/lib/lv2/
}
