# zynthian user interface and engine manager for postmarketOS/Nura (desktop mode).
#
# Built from a local checkout of zynthian-ui (nura branch):
#   pmbootstrap build --src=/path/to/zynthian-ui zynthian-ui
# --src skips $source, so put the Python packages listed there into pmbootstrap's
# distfiles cache first (nura/seed-distfiles.sh). The build then needs no network.
#
# Python packages that Alpine doesn't package are bundled in
# /usr/share/zynthian/python (/usr/bin/zynthian adds it to PYTHONPATH):
# pure-Python wheels and sdists from PyPI, and pyliblo3 built from source
# (PyPI has only glibc wheels of 0.17.0; the 0.16.3 sdist needs Cython < 3).
# tkinterweb (help viewer) is left out: its Tkhtml library isn't packaged.
pkgname=zynthian-ui
pkgver=2610_git20261102
pkgrel=2
pkgdesc="zynthian synthesizer platform: user interface and engine manager"
url="https://github.com/zynthian/zynthian-ui"
arch="aarch64 x86_64"
license="GPL-3.0-or-later"
options="!check"
depends="
	bash
	ffmpeg
	lilv
	py3-beautifulsoup4
	py3-cffi
	py3-dbus
	py3-evdev
	py3-levenshtein
	py3-lilv
	py3-numpy
	py3-pexpect
	py3-pyside6
	py3-pillow
	py3-psutil
	py3-pyalsaaudio
	py3-rdflib
	py3-requests
	py3-scipy
	py3-typing-extensions
	py3-udev
	py3-usb
	py3-websocket-client
	py3-yaml
	python3
	python3-tkinter
	rubberband
	sox
	so:libasound.so.2
	so:libjack.so.0
	so:libsndfile.so.1
	zynthian-data
	zynthian-sys-config
	zyncoder
	zynthian-jalv
	"
makedepends="
	bash
	cmake
	cython
	jack-dev
	liblo-dev
	libsamplerate-dev
	libsndfile-dev
	linux-headers
	nlohmann-json
