# zyncore library of zynthian (MIDI router, controller handling) for postmarketOS/Nura.
#
# Built from a local checkout of zyncoder (nura branch):
#   pmbootstrap build --src=/path/to/zyncoder zyncoder
# The generic library (layout DUMMIES: no GPIO/I2C, for the Duet, desktops, VMs); the zynthian
# kits' builds are zyncoder-hw (its own recipe: aarch64 with wiringpi).
pkgname=zyncoder
pkgver=2610_git20261102
pkgrel=2
pkgdesc="zynthian zyncore library: MIDI router and controller handling"
url="https://github.com/zynthian/zyncoder"
arch="aarch64 x86_64"
license="GPL-3.0-or-later"
options="!check"
depends="python3"
makedepends="
	boost1.89-dev
	cmake
	jack-dev
	liblo-dev
	linux-headers
	samurai
	"
subpackages="$pkgname-dbg"
builddir="$srcdir/$pkgname"

build() {
	# DUMMIES: touch-only layout without GPIO (CMakeLists.txt). No RPATH: the
	# library goes to /usr/lib/zynthian, its dependencies are system libraries.
	ZYNTHIAN_WIRING_LAYOUT=DUMMIES cmake -B build \
		-DCMAKE_BUILD_TYPE=RelWithDebInfo \
		-DCMAKE_SKIP_RPATH=ON
	cmake --build build --target zyncore
}

package() {
	# Same layout as zynthian-ui's desktop/install.sh (component "zyncoder")
	install -Dm755 build/libzyncore.so -t "$pkgdir"/usr/lib/zynthian/
	install -Dm644 __init__.py zyncore.py -t "$pkgdir"/usr/share/zynthian/zynthian-ui/zyncoder/
	python3 -m compileall -q -d /usr/share/zynthian/zynthian-ui/zyncoder \
		"$pkgdir"/usr/share/zynthian/zynthian-ui/zyncoder
}
