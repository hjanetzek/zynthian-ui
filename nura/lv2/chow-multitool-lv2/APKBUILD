# Contributor: Hannes Janetzek <hannes.janetzek@gmail.com>
# ChowMultiTool: EQ, band splitter, brickwall, signal generator, ... (not in zynthian's engine
# config). Eigen (a GitLab submodule) is an extra source too.
# JUCE and the other git submodules are extra sources (nura/tools/gh-submodule-sources.py). LV2
# only. The plugin has its JUCE GUI built in, so it needs X11 and freetype headers to build (JUCE
# loads X11 only when the editor opens).
pkgname=chow-multitool-lv2
pkgver=1.1.0
pkgrel=0
_commit=09b831cf2339aca971ff6e7c6a80c329fa89b49f
_modules_juce=69795dc8e589a9eb5df251b6dd994859bf7b3fab
_modules_chowdsp_utils=eda8931719dde558bed10f4010fb3e5b2c67ec71
_modules_clap_juce_extensions=e72d59a870ab6dea156d4912cbd004b715fca5f7
_modules_clap_juce_extensions_clap_libs_clap=df8f16c69ba1c1a15fb105f0c5a2e5b9ac6be742
_modules_clap_juce_extensions_clap_libs_clap_helpers=7b53a685e11465154b4ccba3065224dbcbf8a893
_modules_chowdsp_wdf=36b5775555af21f0f417d2bc866ba7b4b2788614
_modules_melatonin_inspector=785d1670add6364d9b7b75f8191a2d8875d8c823
_eigen=3147391d946bb4b6c68edd901f2add6ac1f31f8c
pkgdesc="ChowMultiTool EQ, band splitter, signal generator and more (LV2)"
url="https://github.com/Chowdhury-DSP/ChowMultiTool"
arch="aarch64 x86_64"
license="GPL-3.0-or-later"
# linux-headers: xsimd (bundled) includes <asm/hwcap.h>
makedepends="
	alsa-lib-dev
	cmake
	fontconfig-dev
	freetype-dev
	jack-dev
	libx11-dev
	libxcursor-dev
	libxext-dev
	libxinerama-dev
	libxrandr-dev
	linux-headers
	samurai
	"
source="$pkgname-$_commit.tar.gz::https://github.com/Chowdhury-DSP/ChowMultiTool/archive/$_commit.tar.gz
	modules_juce-${_modules_juce}.tar.gz::https://github.com/juce-framework/JUCE/archive/${_modules_juce}.tar.gz
	modules_chowdsp_utils-${_modules_chowdsp_utils}.tar.gz::https://github.com/Chowdhury-DSP/chowdsp_utils/archive/${_modules_chowdsp_utils}.tar.gz
	modules_clap_juce_extensions-${_modules_clap_juce_extensions}.tar.gz::https://github.com/free-audio/clap-juce-extensions/archive/${_modules_clap_juce_extensions}.tar.gz
	modules_clap_juce_extensions_clap_libs_clap-${_modules_clap_juce_extensions_clap_libs_clap}.tar.gz::https://github.com/free-audio/clap/archive/${_modules_clap_juce_extensions_clap_libs_clap}.tar.gz
	modules_clap_juce_extensions_clap_libs_clap_helpers-${_modules_clap_juce_extensions_clap_libs_clap_helpers}.tar.gz::https://github.com/free-audio/clap-helpers/archive/${_modules_clap_juce_extensions_clap_libs_clap_helpers}.tar.gz
	modules_chowdsp_wdf-${_modules_chowdsp_wdf}.tar.gz::https://github.com/Chowdhury-DSP/chowdsp_wdf/archive/${_modules_chowdsp_wdf}.tar.gz
	modules_melatonin_inspector-${_modules_melatonin_inspector}.tar.gz::https://github.com/sudara/melatonin_inspector/archive/${_modules_melatonin_inspector}.tar.gz
	eigen-$_eigen.tar.gz::https://gitlab.com/libeigen/eigen/-/archive/$_eigen/eigen-$_eigen.tar.gz
	"
builddir="$srcdir/ChowMultiTool-$_commit"
options="!check" # no tests

prepare() {
	# musl: no execinfo.h (JUCE uses backtrace() for crash reports only): a stub without backtraces
	mkdir -p "$srcdir"/musl-compat
	cat > "$srcdir"/musl-compat/execinfo.h <<-'EOF'
	#pragma once
	static inline int backtrace(void **buf, int size) { (void) buf; (void) size; return 0; }
	static inline char **backtrace_symbols(void *const *buf, int size) { (void) buf; (void) size; return 0; }
	EOF
	# git submodules (outer ones first)
	rm -rf modules/JUCE && mv "$srcdir"/JUCE-${_modules_juce} modules/JUCE
	rm -rf modules/chowdsp_utils && mv "$srcdir"/chowdsp_utils-${_modules_chowdsp_utils} modules/chowdsp_utils
	rm -rf modules/clap-juce-extensions && mv "$srcdir"/clap-juce-extensions-${_modules_clap_juce_extensions} modules/clap-juce-extensions
	rm -rf modules/clap-juce-extensions/clap-libs/clap && mv "$srcdir"/clap-${_modules_clap_juce_extensions_clap_libs_clap} modules/clap-juce-extensions/clap-libs/clap
	rm -rf modules/clap-juce-extensions/clap-libs/clap-helpers && mv "$srcdir"/clap-helpers-${_modules_clap_juce_extensions_clap_libs_clap_helpers} modules/clap-juce-extensions/clap-libs/clap-helpers
	rm -rf modules/chowdsp_wdf && mv "$srcdir"/chowdsp_wdf-${_modules_chowdsp_wdf} modules/chowdsp_wdf
	rm -rf modules/melatonin_inspector && mv "$srcdir"/melatonin_inspector-${_modules_melatonin_inspector} modules/melatonin_inspector
	rm -rf modules/eigen && mv "$srcdir"/eigen-$_eigen modules/eigen
	default_prepare
	# GCC 15's LTO crashes on it (internal compiler error in write_symbol): no JUCE LTO flags
	find . -name CMakeLists.txt -not -path './modules/JUCE/*' \
		-exec sed -i '/juce::juce_recommended_lto_flags/d' {} +
	# LV2 only
	sed -i 's/set(JUCE_FORMATS AU VST3 Standalone)/set(JUCE_FORMATS)/; s/FORMATS AU VST3 Standalone/FORMATS /' \
		CMakeLists.txt
}

build() {
	# musl: the execinfo.h stub; stat64 and friends only with _LARGEFILE64_SOURCE; glibc's
	# _NL_IDENTIFICATION_*/_NL_ADDRESS_* locale items as items musl doesn't have (nl_langinfo() returns "");
	# <utility> for std::exchange, which older JUCE gets indirectly from glibc's libstdc++ headers
	# -Wno-template-body: GCC 15 errors in templates that are never instantiated (chowdsp_utils)
	export CXXFLAGS="$CXXFLAGS -I$srcdir/musl-compat -D_LARGEFILE64_SOURCE -include utility -Wno-template-body \
		-D_NL_IDENTIFICATION_LANGUAGE=0x60000 -D_NL_IDENTIFICATION_TERRITORY=0x60001 \
		-D_NL_ADDRESS_LANG_AB=0x60002 -D_NL_ADDRESS_COUNTRY_AB2=0x60003"
	export CFLAGS="$CFLAGS -I$srcdir/musl-compat -D_LARGEFILE64_SOURCE"
	# CMake 4: some (sub)projects declare cmake_minimum_required < 3.5
	cmake -S . -B build -G Ninja -DCMAKE_POLICY_VERSION_MINIMUM=3.5 -DCMAKE_BUILD_TYPE=Release 
	# at most 3 jobs: the JUCE translation units need ~1 GB each (the Duet has 4 GB)
	cmake --build build --parallel 3 --target ChowMultiTool_LV2
}

package() {
	mkdir -p "$pkgdir"/usr/lib/lv2
	# bundle names can contain spaces ("Ultramaster KR-106.lv2")
	find build -type d -path '*/LV2/*.lv2' -prune -exec cp -r {} "$pkgdir"/usr/lib/lv2/ \;
}
