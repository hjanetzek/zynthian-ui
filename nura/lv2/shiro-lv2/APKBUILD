# Contributor: Hannes Janetzek <hannes.janetzek@gmail.com>
# SHIRO plugins (Shiroverb, Modulay, Larynx, Harmless; URIs https://github.com/ninodewit/SHIRO-Plugins/...),
# enabled by default in zynthian (zynthian-sys recipe install_shiro.sh). DPF is a git submodule,
# not in GitHub's archive: a second source. Not the submodule's DPF (2020): with it the plugins
# don't instantiate in jalv ("Failed to instantiate plugin", without a reason); built against the
# DPF of ykchorus-lv2, which works, with the MOD web GUI description (modgui) off, as the newer DPF
# needs more settings for it and the kiosk doesn't use it. DSP only, no GUIs; NOOPT: no x86 flags.
pkgname=shiro-lv2
_commit=3e0a1d35f6ddfe3430e5921e0d55cf60574f8bc3
_dpf=077fcf5758ed6038bfe6e7aee1e407aa02e807b2
pkgver=0_git20201109
pkgrel=1
pkgdesc="SHIRO LV2 plugins"
url="https://github.com/ninodewit/SHIRO-Plugins"
arch="all"
license="GPL-3.0-or-later"
# bash: DPF's utils/generate-ttl.sh (run in build()) is a bash script
makedepends="bash lv2-dev"
source="$pkgname-$_commit.tar.gz::https://github.com/ninodewit/SHIRO-Plugins/archive/$_commit.tar.gz
	dpf-$_dpf.tar.gz::https://github.com/DISTRHO/DPF/archive/$_dpf.tar.gz"
builddir="$srcdir/SHIRO-Plugins-$_commit"
options="!check" # no tests

_plugins="shiroverb modulay larynx harmless"

prepare() {
	default_prepare
	rmdir dpf
	mv "$srcdir"/DPF-$_dpf dpf
	sed -i 's/#define DISTRHO_PLUGIN_USES_MODGUI *1/#define DISTRHO_PLUGIN_USES_MODGUI 0/' \
		plugins/*/DistrhoPluginInfo.h
}

build() {
	local p
	for p in $_plugins; do
		make -C plugins/$p NOOPT=true HAVE_OPENGL=false lv2_dsp
	done
	make -C dpf/utils/lv2-ttl-generator
	dpf/utils/generate-ttl.sh
}

package() {
	mkdir -p "$pkgdir"/usr/lib/lv2
	cp -r bin/*.lv2 "$pkgdir"/usr/lib/lv2/
}
sha512sums="
