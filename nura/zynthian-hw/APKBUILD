# Contributor: Hannes Janetzek <hannes.janetzek@gmail.com>
# zynthian hardware on Nura (the zynthian kits on a Raspberry Pi, with device-zynthian-rpi4):
# zynthian-kit selects the kit as ZynthianOS does (the kit's settings from zynthian-sys into the
# user's zynthian_envars.sh, its overlays and kernel options to /boot, the interfaces' groups),
# zyncoder-hw has the kits' builds of zyncoder, and the device user gets passwordless sudo for
# what zynthian does as root on ZynthianOS (a first step). Plan: nura-builds docs/zynthian-rpi.md.
pkgname=zynthian-hw
pkgver=1
pkgrel=0
pkgdesc="zynthian hardware support: kit selection, zyncoder for the kits"
url="https://github.com/hjanetzek/zynthian-ui"
arch="aarch64"
license="GPL-3.0-or-later"
depends="
	cmd:sudo
	i2c-tools
	zyncoder-hw
	zynthian-sys-config
	"
options="!check"
source="
	zynthian-kit
	sudoers
	"

package() {
	install -Dm755 "$srcdir"/zynthian-kit "$pkgdir"/usr/bin/zynthian-kit
	install -Dm440 "$srcdir"/sudoers "$pkgdir"/etc/sudoers.d/90-zynthian-hw
}
sha512sums="
94d68c0c712f1295984565d938dfebd4a6983bc9f952496482f19a37decadbbcd4d33b73ab18f324410525752a01a26ca67942c5a46085066439412ac91e959d  zynthian-kit
f7e3144d4366d2f0805a69b61803e44d42176b34970af57961a7c1b031aa94584f8e0bafc3ba9fff76f13cc3633a20ba61a3030622ff861265b5e70f66662b5c  sudoers
"
