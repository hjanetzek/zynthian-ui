# Contributor: Hannes Janetzek <hannes.janetzek@gmail.com>
# unauthorized (Yves Degoyon's objects; zynthian's patches use [grid]), Debian pd-unauthorized on
# ZynthianOS. Debian's source and patches; each object is one C file, compiled here directly
# (the Makefile is an old Pd-extended template), without the mp3*/speex* objects (LAME, Speex).
# Installed to /usr/lib/pd/extra/unauthorized.
pkgname=pd-unauthorized
pkgver=0.1
_debrel=9
pkgrel=0
pkgdesc="unauthorized objects for Pure Data"
url="https://salsa.debian.org/multimedia-team/pd/pd-unauthorized"
arch="all"
license="GPL-2.0-or-later"
depends="puredata"
makedepends="puredata-dev"
source="https://deb.debian.org/debian/pool/main/p/pd-unauthorized/pd-unauthorized_$pkgver.orig.tar.gz
	https://deb.debian.org/debian/pool/main/p/pd-unauthorized/pd-unauthorized_$pkgver-$_debrel.debian.tar.xz"
builddir="$srcdir/unauthorized-$pkgver"
options="!check" # no tests

# Old C: GCC 14 made implicit declarations, implicit int and incompatible pointer types errors
# (-fpermissive turns them back into warnings), GCC 15 defaults to C23
_oldc="-std=gnu17 -fpermissive"
_objects="audience~ beatify~ blinkenlights compressor~ cooled~ countund disto~ exciter filterbank~
	formant~ grid pianoroll playlist probalizer randomblock~ samplebox~ scratcher~ scrolllist
	sonogram~ spigot~ wahwah~"

prepare() {
	default_prepare
	local p
	for p in $(cat "$srcdir"/debian/patches/series 2>/dev/null); do
		patch -p1 -i "$srcdir"/debian/patches/$p
	done
}

build() {
	local o
	for o in $_objects; do
		${CC:-cc} $CFLAGS $_oldc $CPPFLAGS -fPIC -shared $LDFLAGS -DPD -I/usr/include/pd \
			"$o.c" -o "$o.pd_linux" -lm
	done
}

package() {
	local d="$pkgdir"/usr/lib/pd/extra/unauthorized o
	mkdir -p "$d"
	for o in $_objects; do
		cp "$o.pd_linux" "$d"/
		[ -f "$o-help.pd" ] && cp "$o-help.pd" "$d"/
	done
	return 0
}
