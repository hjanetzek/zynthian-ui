# Contributor: Hannes Janetzek <hannes.janetzek@gmail.com>
# freeverb~ (Jezar's Freeverb for Pure Data), used by zynthian's puredata patches (Debian
# pd-freeverb on ZynthianOS). Debian's source and patches; installed to /usr/lib/pd/extra/freeverb.
pkgname=pd-freeverb
pkgver=1.3.0
_debrel=1
pkgrel=0
pkgdesc="freeverb~ reverb for Pure Data"
url="https://salsa.debian.org/multimedia-team/pd/pd-freeverb"
arch="all"
license="GPL-2.0-or-later"
depends="puredata"
makedepends="puredata-dev"
source="https://deb.debian.org/debian/pool/main/p/pd-freeverb/pd-freeverb_$pkgver.orig.tar.gz
	https://deb.debian.org/debian/pool/main/p/pd-freeverb/pd-freeverb_$pkgver-$_debrel.debian.tar.xz"
builddir="$srcdir/pd-freeverb-$pkgver"
options="!check" # no tests

# Old C: GCC 14 made implicit declarations, implicit int and incompatible pointer types errors
# (-fpermissive turns them back into warnings), GCC 15 defaults to C23
_oldc="-std=gnu17 -fpermissive"

prepare() {
	default_prepare
	local p
	for p in $(cat "$srcdir"/debian/patches/series); do
		patch -p1 -i "$srcdir"/debian/patches/$p
	done
}

build() {
	make PDINCLUDEDIR=/usr/include/pd CFLAGS="$CFLAGS $_oldc"
}

package() {
	make install PDINCLUDEDIR=/usr/include/pd CFLAGS="$CFLAGS $_oldc" DESTDIR="$pkgdir" pkglibdir=/usr/lib/pd/extra
}
sha512sums="
