# Contributor: Hannes Janetzek <hannes.janetzek@gmail.com>
# Invada Studio plugins (URIs http://invadarecords.com/plugins/lv2/...), enabled by default in
# zynthian (Debian invada-studio-plugins-lv2 on ZynthianOS). Debian's source and patches
# (header location, flags, GCC 14); the plugins only, without the GTK 2 GUIs.
pkgname=invada-lv2
pkgver=1.2.0
_debver=1.2.0+repack0
_debrel=10
pkgrel=0
pkgdesc="Invada Studio LV2 plugins"
url="https://launchpad.net/invada-studio"
arch="all"
license="GPL-2.0-or-later"
makedepends="lv2-dev"
source="https://deb.debian.org/debian/pool/main/i/invada-studio-plugins-lv2/invada-studio-plugins-lv2_$_debver.orig.tar.gz
	https://deb.debian.org/debian/pool/main/i/invada-studio-plugins-lv2/invada-studio-plugins-lv2_$_debver-$_debrel.debian.tar.xz"
builddir="$srcdir/invada-studio-plugins-lv2-$pkgver"
options="!check" # no tests

prepare() {
	default_prepare
	local p
	for p in $(cat "$srcdir"/debian/patches/series); do
		patch -p1 -i "$srcdir"/debian/patches/$p
	done
}

build() {
	make -C plugin/library
	make -C plugin
}

package() {
	local dest="$pkgdir"/usr/lib/lv2/invada.lv2
	mkdir -p "$dest"
	cp plugin/*.so rdf/*.ttl "$dest"/
}
