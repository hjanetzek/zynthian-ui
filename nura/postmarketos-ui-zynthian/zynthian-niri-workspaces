#!/usr/bin/python3
"""Started by niri (zynthian-niri session): places new windows by the layout (zynthian-niri-layout).

Layout "workspaces" (the default): every window but zynthian's on a workspace of its own,
full-screen: resizable plugin GUIs (JUCE) fill the screen, fixed-size ones are centred in jalv's
window.

Follows niri's event stream; a newly opened window that isn't zynthian's is moved to the last
workspace of its output, which niri keeps empty (dynamic workspaces): so each plugin window gets
its own workspace, and the workspace goes away again when the window closes. Index 255 stands for
"the last one" (niri clamps the index to the number of workspaces). When a window closes and
nothing has the focus any more (its workspace is empty now), zynthian's workspace is shown.

Layout "scrolling": new windows become columns next to zynthian on its workspace.
"""
import json
import os
import subprocess
import time

ZYNTHIAN_APP_ID = "zynthian"


def is_zynthian(w):
    # by app_id, or by title (a UI without setDesktopFileName has app_id python3)
    return w.get("app_id") == ZYNTHIAN_APP_ID or (w.get("app_id") == "python3"
                                                   and w.get("title") == "zynthian")
MODE_FILE = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "zynthian-niri-layout")


FULLSCREEN_FILE = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "zynthian-niri-fullscreen")


def fullscreen_ids():
    # The windows made full-screen here (niri can only toggle full-screen, and doesn't report it)
    try:
        with open(FULLSCREEN_FILE) as f:
            return set(json.load(f))
    except (OSError, ValueError):
        return set()


def save_fullscreen_ids(ids):
    with open(FULLSCREEN_FILE, "w") as f:
        json.dump(sorted(ids), f)


def set_fullscreen(wid, on):
    ids = fullscreen_ids()
    if on != (wid in ids):
        niri("action", "fullscreen-window", "--id", str(wid))
        ids = ids | {wid} if on else ids - {wid}
        save_fullscreen_ids(ids)


def scrolling():
    try:
        with open(MODE_FILE) as f:
            return f.read().strip() == "scrolling"
    except OSError:
        return False


def niri(*args):
    return subprocess.run(["niri", "msg", *args], capture_output=True, text=True)


def follow():
    known = set()
    stream = subprocess.Popen(["niri", "msg", "--json", "event-stream"],
                              stdout=subprocess.PIPE, text=True)
    for line in stream.stdout:
        try:
            ev = json.loads(line)
        except ValueError:
            continue
        if "WindowsChanged" in ev:
            known = {w["id"] for w in ev["WindowsChanged"]["windows"]}
        elif "WindowOpenedOrChanged" in ev:
            w = ev["WindowOpenedOrChanged"]["window"]
            if w["id"] in known:
                continue
            known.add(w["id"])
            if is_zynthian(w):
                continue
            # TODO: dialogs of a plugin (file choosers) should stay with its window
            wid = str(w["id"])
            if scrolling():
                niri("action", "move-window-to-workspace", "--window-id", wid, "--focus", "true",
                     "zynthian")
                niri("action", "move-window-to-tiling", "--id", wid)
            else:
                niri("action", "move-window-to-workspace", "--window-id", wid, "--focus", "true",
                     "255")
            # --focus only follows a focused window; a window shown again (jalv.gtk3 "ui show")
            # opens unfocused
            niri("action", "focus-window", "--id", wid)
            if not scrolling():
                set_fullscreen(w["id"], True)
        elif "WindowClosed" in ev:
            known.discard(ev["WindowClosed"]["id"])
            ids = fullscreen_ids()
            if ev["WindowClosed"]["id"] in ids:
                save_fullscreen_ids(ids - {ev["WindowClosed"]["id"]})
            if niri("--json", "focused-window").stdout.strip() in ("", "null"):
                niri("action", "focus-workspace", "zynthian")
    stream.wait()


while True:
    follow()
    time.sleep(1)  # niri restarting its IPC, or not up yet
