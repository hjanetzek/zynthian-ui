# zynthian's factory data, help pages and configuration templates for postmarketOS/Nura.
# Built from the upstream repositories (vangelis branch), unchanged.
pkgname=zynthian-data
pkgver=2610_git20261030
pkgrel=0
pkgdesc="zynthian factory data: presets, soundfonts, snapshots, sample files"
url="https://github.com/zynthian/zynthian-data"
arch="noarch"
license="GPL-3.0-or-later AND custom"
options="!check"
subpackages="zynthian-help:_help zynthian-sys-config:_sys_config"
_data_commit=271e9188cc6bcbd5ff89ba27d1b312a8c68a3417
_help_commit=510e768852648f1ea11d5f2d3a94a3c818f6368d
_sys_commit=c2eea576e528e451270b829aa114f504bd34ee90
source="
	zynthian-data-$_data_commit.tar.gz::https://github.com/zynthian/zynthian-data/archive/$_data_commit.tar.gz
	zynthian-help-$_help_commit.tar.gz::https://github.com/zynthian/zynthian-help/archive/$_help_commit.tar.gz
	zynthian-sys-$_sys_commit.tar.gz::https://github.com/zynthian/zynthian-sys/archive/$_sys_commit.tar.gz
	"
builddir="$srcdir"

# Same layout as zynthian-ui's desktop/install.sh (components data, help, sys)
package() {
	mkdir -p "$pkgdir"/usr/share/zynthian
	cp -a zynthian-data-$_data_commit "$pkgdir"/usr/share/zynthian/zynthian-data

	# Drop the prebuilt binaries (Pure Data externals, a plugin UI): built for ZynthianOS
	# (glibc, ARM), they can't load here, and they would make this package arch-specific.
	# scanelf comes with pax-utils, which abuild depends on.
	scanelf -RBF '%F' "$pkgdir" | while read -r f; do
		rm -f "$f"
	done
}

_help() {
	pkgdesc="zynthian help pages"
	url="https://github.com/zynthian/zynthian-help"
	license="GPL-3.0-or-later"
	mkdir -p "$subpkgdir"/usr/share/zynthian
	cp -a "$srcdir"/zynthian-help-$_help_commit "$subpkgdir"/usr/share/zynthian/zynthian-help
}

_sys_config() {
	pkgdesc="zynthian configuration templates (from zynthian-sys)"
	url="https://github.com/zynthian/zynthian-sys"
	license="GPL-3.0-or-later"
	mkdir -p "$subpkgdir"/usr/share/zynthian/zynthian-sys
	cp -a "$srcdir"/zynthian-sys-$_sys_commit/config "$subpkgdir"/usr/share/zynthian/zynthian-sys/config
}

