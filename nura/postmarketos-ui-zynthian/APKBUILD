af9d55c4a9f2e4db40effe75dc6b01811a22778865e7792c00a30f5ba2e737c2930c688f6ede9e5751ea05f4a4c8e0354811b214cc0394bfc41b35be785a4449  50-zynthian-realtime.conf
9429e540ad1d01dc4eb04db3ee626323f5e9fa0992ca2d515908732d57d6aca38f60475efd9e0057b4e7aa900dfbcb93f054798b4b66600ba1a081442cf6e025  zynthian-xwayland.sh
c87b65ee5b9a3154fcdcb0e4004b439e1c1b13c98aefc144e149a51d5d6f08aae23cbd76ae455008d0cb3c18a9fb015feedd34cb2a53e39bd775ad232686957a  xwayland-noglamor
