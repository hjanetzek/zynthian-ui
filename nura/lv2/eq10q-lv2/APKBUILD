# Contributor: Hannes Janetzek <hannes.janetzek@gmail.com>
# EQ10Q: parametric EQs, compressors, gates (URIs http://eq10q.sourceforge.net/...; zynthian
# enables 8 of them, Debian's eq10q on ZynthianOS). Debian's source and patches (prefix, no SSE
# flags, the distribution's flags, LV2 types, pow10, CMake 4, no GTK GUI); the TTLs still name the
# GtkUI, which hosts skip when its binary is missing.
pkgname=eq10q-lv2
pkgver=2.2
pkgrel=0
_debver=2.2~repack0
pkgdesc="EQ10Q equalizer and dynamics LV2 plugins (no GUI)"
url="https://eq10q.sourceforge.net"
arch="all"
license="GPL-3.0-or-later"
makedepends="cmake fftw-dev lv2-dev samurai"
source="https://deb.debian.org/debian/pool/main/e/eq10q/eq10q_$_debver.orig.tar.gz
	01-fix_prexix.patch
	02-remove_sse_flags.patch
	03-fix_flags.patch
	04-spelling.patch
	05-pow10.patch
	0006-Fix-lv2-types.patch
	07-Prevent-gui-build.patch
	cmake-4.patch
	"
builddir="$srcdir/eq10q-$pkgver"
options="!check" # no tests

build() {
	cmake -B build -G Ninja -DCMAKE_BUILD_TYPE=None
	cmake --build build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}
