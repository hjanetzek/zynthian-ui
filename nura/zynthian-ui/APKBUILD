	py3-setuptools
	py3-wheel
	python3-dev
	rubberband-dev
	samurai
	"
subpackages="$pkgname-dbg"
_pyliblo3_commit=029b83a03b4f24d905f818591903411753901273
_pywheels="
	jack_client-0.5.7-py3-none-any.whl
	soundfile-0.14.0-py2.py3-none-any.whl
	alsa_midi-1.0.4-py3-none-any.whl
