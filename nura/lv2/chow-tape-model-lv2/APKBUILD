# Contributor: Hannes Janetzek <hannes.janetzek@gmail.com>
# CHOWTapeModel analog tape emulation (URI https://github.com/jatinchowdhury18/AnalogTapeModel; zynthian's recipe
# install_CHOWTapeModel.sh). JUCE (lv2-porting-project's fork) and the other git submodules are extra sources
# (nura/tools/gh-submodule-sources.py). LV2 only. The plugin has its JUCE GUI built in, so it needs
# X11 and freetype headers to build (JUCE loads X11 only when the editor opens).
pkgname=chow-tape-model-lv2
pkgver=2.11.4
pkgrel=0
_commit=604372e4ffd9690c3e283362e4598cb43edbb475
_plugin_modules_foleys_gui_magic=bf56946522cffa84e124dacd24240d156d83e7f7
_plugin_modules_chowdsp_utils=39851f124e26c1d5ef92a298a5e0973650075b57
_plugin_modules_rtneural=0ec5023fb6e3d5060613705ad0f9c31956a52680
_plugin_modules_rtneural_modules_xsimd=31298c883bda0f3dfcf44170f45be242deb78f1a
_plugin_modules_juce=ebbe26fd877ac7248c9bb800b56a4786bf538cdb
_plugin_modules_clap_juce_extensions=5f369ad244e4b1ccd2eb943bd6dac993fb444262
_plugin_modules_clap_juce_extensions_clap_libs_clap=41964fa3f44fdbf6feb20df528a9cdf2cc3b05ba
_plugin_modules_clap_juce_extensions_clap_libs_clap_helpers=41e1086488f5cd27da871d07edb8eccea99e556d
pkgdesc="CHOWTapeModel analog tape emulation (LV2)"
url="https://github.com/jatinchowdhury18/AnalogTapeModel"
arch="aarch64 x86_64"
license="GPL-3.0-or-later"
makedepends="
	alsa-lib-dev
	cmake
	fontconfig-dev
	freetype-dev
	jack-dev
	libx11-dev
	libxcursor-dev
	libxext-dev
	libxinerama-dev
	libxrandr-dev
	lv2-dev
	samurai
	"
source="$pkgname-$_commit.tar.gz::https://github.com/jatinchowdhury18/AnalogTapeModel/archive/$_commit.tar.gz
	plugin_modules_foleys_gui_magic-${_plugin_modules_foleys_gui_magic}.tar.gz::https://github.com/Chowdhury-DSP/foleys_gui_magic/archive/${_plugin_modules_foleys_gui_magic}.tar.gz
	plugin_modules_chowdsp_utils-${_plugin_modules_chowdsp_utils}.tar.gz::https://github.com/Chowdhury-DSP/chowdsp_utils/archive/${_plugin_modules_chowdsp_utils}.tar.gz
	plugin_modules_rtneural-${_plugin_modules_rtneural}.tar.gz::https://github.com/jatinchowdhury18/RTNeural/archive/${_plugin_modules_rtneural}.tar.gz
	plugin_modules_rtneural_modules_xsimd-${_plugin_modules_rtneural_modules_xsimd}.tar.gz::https://github.com/xtensor-stack/xsimd/archive/${_plugin_modules_rtneural_modules_xsimd}.tar.gz
	plugin_modules_juce-${_plugin_modules_juce}.tar.gz::https://github.com/lv2-porting-project/JUCE/archive/${_plugin_modules_juce}.tar.gz
	plugin_modules_clap_juce_extensions-${_plugin_modules_clap_juce_extensions}.tar.gz::https://github.com/free-audio/clap-juce-extensions/archive/${_plugin_modules_clap_juce_extensions}.tar.gz
	plugin_modules_clap_juce_extensions_clap_libs_clap-${_plugin_modules_clap_juce_extensions_clap_libs_clap}.tar.gz::https://github.com/free-audio/clap/archive/${_plugin_modules_clap_juce_extensions_clap_libs_clap}.tar.gz
	plugin_modules_clap_juce_extensions_clap_libs_clap_helpers-${_plugin_modules_clap_juce_extensions_clap_libs_clap_helpers}.tar.gz::https://github.com/free-audio/clap-helpers/archive/${_plugin_modules_clap_juce_extensions_clap_libs_clap_helpers}.tar.gz
	"
builddir="$srcdir/AnalogTapeModel-$_commit"
options="!check" # no tests

prepare() {
	# musl: no execinfo.h (JUCE uses backtrace() for crash reports only): a stub without backtraces
	mkdir -p "$srcdir"/musl-compat
	cat > "$srcdir"/musl-compat/execinfo.h <<-'EOF'
	#pragma once
	static inline int backtrace(void **buf, int size) { (void) buf; (void) size; return 0; }
	static inline char **backtrace_symbols(void *const *buf, int size) { (void) buf; (void) size; return 0; }
	EOF
	# git submodules (outer ones first)
	rm -rf Plugin/modules/foleys_gui_magic && mv "$srcdir"/foleys_gui_magic-${_plugin_modules_foleys_gui_magic} Plugin/modules/foleys_gui_magic
	rm -rf Plugin/modules/chowdsp_utils && mv "$srcdir"/chowdsp_utils-${_plugin_modules_chowdsp_utils} Plugin/modules/chowdsp_utils
	rm -rf Plugin/modules/RTNeural && mv "$srcdir"/RTNeural-${_plugin_modules_rtneural} Plugin/modules/RTNeural
	rm -rf Plugin/modules/RTNeural/modules/xsimd && mv "$srcdir"/xsimd-${_plugin_modules_rtneural_modules_xsimd} Plugin/modules/RTNeural/modules/xsimd
	rm -rf Plugin/modules/JUCE && mv "$srcdir"/JUCE-${_plugin_modules_juce} Plugin/modules/JUCE
	rm -rf Plugin/modules/clap-juce-extensions && mv "$srcdir"/clap-juce-extensions-${_plugin_modules_clap_juce_extensions} Plugin/modules/clap-juce-extensions
	rm -rf Plugin/modules/clap-juce-extensions/clap-libs/clap && mv "$srcdir"/clap-${_plugin_modules_clap_juce_extensions_clap_libs_clap} Plugin/modules/clap-juce-extensions/clap-libs/clap
	rm -rf Plugin/modules/clap-juce-extensions/clap-libs/clap-helpers && mv "$srcdir"/clap-helpers-${_plugin_modules_clap_juce_extensions_clap_libs_clap_helpers} Plugin/modules/clap-juce-extensions/clap-libs/clap-helpers
	default_prepare
	# its JUCE's LV2 wrapper includes the LV2 headers by their pre-1.18 paths
	# (lv2/lv2plug.in/ns/{lv2core,ext/*,extensions/*}): a symlink tree to the current ones
	local d n ns="$srcdir"/musl-compat/lv2/lv2plug.in/ns
	mkdir -p "$ns"/ext "$ns"/extensions
	ln -s /usr/include/lv2/core "$ns"/lv2core
	for d in /usr/include/lv2/*/; do
		n=$(basename "$d")
		case $n in
		core) ;;
		ui|units) ln -s "$d" "$ns"/extensions/$n ;;
		*) ln -s "$d" "$ns"/ext/$n ;;
		esac
	done
	# LV2 only, no CLAP
	sed -i 's/set(JUCE_FORMATS AU VST3 Standalone)/set(JUCE_FORMATS)/' Plugin/CMakeLists.txt
}

build() {
	# musl: the execinfo.h stub; stat64 and friends only with _LARGEFILE64_SOURCE; glibc's
	# _NL_IDENTIFICATION_*/_NL_ADDRESS_* locale items as items musl doesn't have (nl_langinfo() returns "");
	# <utility> for std::exchange, which older JUCE gets indirectly from glibc's libstdc++ headers
	# -Wno-template-body: GCC 15 errors in templates that are never instantiated (chowdsp_utils)
	export CXXFLAGS="$CXXFLAGS -I$srcdir/musl-compat -D_LARGEFILE64_SOURCE -include utility -Wno-template-body \
		-D_NL_IDENTIFICATION_LANGUAGE=0x60000 -D_NL_IDENTIFICATION_TERRITORY=0x60001 \
		-D_NL_ADDRESS_LANG_AB=0x60002 -D_NL_ADDRESS_COUNTRY_AB2=0x60003"
	export CFLAGS="$CFLAGS -I$srcdir/musl-compat -D_LARGEFILE64_SOURCE"
	# CMake 4: some (sub)projects declare cmake_minimum_required < 3.5
	cmake -S Plugin -B build -G Ninja -DCMAKE_POLICY_VERSION_MINIMUM=3.5 -DCMAKE_BUILD_TYPE=Release -DCHOWTAPE_BUILD_CLAP=OFF
	cmake --build build --target CHOWTapeModel_LV2
}

package() {
	local d
	mkdir -p "$pkgdir"/usr/lib/lv2
	for d in $(find build -type d -path '*/LV2/*.lv2' -prune); do
		cp -r "$d" "$pkgdir"/usr/lib/lv2/
	done
}
