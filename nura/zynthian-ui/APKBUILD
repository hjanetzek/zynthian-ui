	pyrubberband-0.4.0-py3-none-any.whl
	abletonparsing-0.1.3-py3-none-any.whl
	future-1.0.0-py3-none-any.whl
	"
_pysdists="
	sox-1.5.0.tar.gz
	hwmon-1.0.tar.gz
	pyliblo3-$_pyliblo3_commit.tar.gz
	"
source="
	https://files.pythonhosted.org/packages/54/dd/ba4f56992e958a2b6a4a0603a7bf69f5de275538eee4041e77e1f9882719/jack_client-0.5.7-py3-none-any.whl
	https://files.pythonhosted.org/packages/b1/d1/5e338af9ca6ed0786cd5bb03f6d60de1c325728c1189014f3b59aae7403c/soundfile-0.14.0-py2.py3-none-any.whl
	https://files.pythonhosted.org/packages/1b/4b/762472e90fc105a0897964f719d40728e6830c91a0f80e1fe90463b05c45/alsa_midi-1.0.4-py3-none-any.whl
	https://files.pythonhosted.org/packages/37/aa/111610d8bf5b1bb7a295a048fc648cec346347a8b0be5881defd2d1b4a52/oyaml-1.0-py2.py3-none-any.whl
	https://files.pythonhosted.org/packages/87/9a/50c7b7107b98330d295f82a38a8d33210fb33ca472cbdd18dce4ca2fdaec/wavio-0.0.9-py3-none-any.whl
	https://files.pythonhosted.org/packages/d7/0c/56be52741f75bad4dc6555991fabd2e07b432d333da82c11ad701123888a/ffmpeg_python-0.2.0-py3-none-any.whl
	https://files.pythonhosted.org/packages/d8/88/238aa67e353012d8dd999372aedada3f627bc9895d5d2a5305e7ffb1affd/pyrubberband-0.4.0-py3-none-any.whl
	https://files.pythonhosted.org/packages/cf/5e/f8e31535f6483801d8790c65871ea8416429234a578d46aee7e898b0166d/abletonparsing-0.1.3-py3-none-any.whl
	https://files.pythonhosted.org/packages/da/71/ae30dadffc90b9006d77af76b393cb9dfbfc9629f339fc1574a1c52e6806/future-1.0.0-py3-none-any.whl
	https://files.pythonhosted.org/packages/3d/a2/d8e0d8fd7abf509ead4a2cb0fb24e5758b5330166bf9223d5cb9f98a7e8d/sox-1.5.0.tar.gz
	https://files.pythonhosted.org/packages/3d/3c/d1f552e63b2c1f4ea462c1f788801f88a64a22f3c59275a8596564abb5fe/hwmon-1.0.tar.gz
	pyliblo3-$_pyliblo3_commit.tar.gz::https://github.com/gesellkammer/pyliblo3/archive/$_pyliblo3_commit.tar.gz
	"
builddir="$srcdir/$pkgname"

# A source file: unpacked by abuild into $srcdir, or (with --src) from the distfiles cache
_srcfile() {
	if [ -e "$srcdir/$1" ]; then
		echo "$srcdir/$1"
	else
		echo "$SRCDEST/$1"
	fi
}

build() {
	# With --src, abuild doesn't fetch $source: the files must be in the distfiles cache
	local f
	for f in $_pywheels $_pysdists; do
		[ -e "$(_srcfile $f)" ] || die "$f missing from $SRCDEST: run nura/seed-distfiles.sh"
	done

	# Native libraries, without RPATH: they go to /usr/lib/zynthian and only use system libraries
	local lib
	for lib in zynsmf zynseq zynaudioplayer zynmixer zynclippy; do
		cmake -S zynlibs/$lib -B zynlibs/$lib/build \
			-DCMAKE_BUILD_TYPE=RelWithDebInfo \
			-DCMAKE_SKIP_RPATH=ON \
			-DCMAKE_CXX_FLAGS="$CXXFLAGS -Wno-psabi" \
			-DENABLE_OSC=0
		cmake --build zynlibs/$lib/build
	done

	# Wheels of the bundled Python packages that come as source
	local pysrc="$srcdir"/pysrc
	rm -rf "$pysrc" "$srcdir"/pywheels
	mkdir -p "$pysrc" "$srcdir"/pywheels
	for f in $_pysdists; do
		tar --no-same-owner -xzf "$(_srcfile $f)" -C "$pysrc"
	done
	for f in "$pysrc"/*/; do
		python3 -m pip wheel --no-index --no-deps --no-build-isolation \
			--wheel-dir "$srcdir"/pywheels "$f"
	done
}

package() {
	PREFIX=/usr ./desktop/install.sh ui "$pkgdir"

	local f pydir="$pkgdir"/usr/share/zynthian/python
	local wheels=
	for f in $_pywheels; do
		wheels="$wheels $(_srcfile $f)"
	done
	# shellcheck disable=SC2086 # list of files
	python3 -m pip install --no-index --no-deps --no-compile --target "$pydir" \
		$wheels "$srcdir"/pywheels/*.whl
	rm -rf "$pydir"/bin # pyliblo3's command line tools
	python3 -m compileall -q -d /usr/share/zynthian/python "$pydir"
}

